{
  "name": "flight-planner",
  "version": "0.1.0",
  "description": "Флайт-планнер для авиасимуляторов: маршруты по реальным точкам, METAR, выбор ВПП и заходов, расчёт топлива и загрузки",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "update-data": "node scripts/fetch-data.js",
    "build-tour": "node scripts/build-tour.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@squawk/airport-data": "^0.8.0",
    "@squawk/airway-data": "^0.6.0",
    "@squawk/fix-data": "^0.7.0",
    "@squawk/navaid-data": "^0.7.0",
    "@squawk/procedure-data": "^0.8.0"
  }
}
